@using Fanex.ApolloParlayRMS.Core.Constants
@using Fanex.ApolloParlayRMS.Core.Extensions
@using Fanex.ApolloParlayRMS.Core.Models
@using Fanex.ApolloParlayRMS.Core.Web
@{
	ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
	Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
	@Styles.Render("~/Themes/BetList")
	@Styles.Render("~/Themes/MemberManagement")
}
@section Headline {
	<h1>
		<span class="title"><span class="first">@Lang.Tools /</span>
			@ViewBag.Title
		</span>
	</h1>
}
<section id="filter-bar">
	<div class="filter-form">
		<div class="filter-row">	
			<div class="filter-cell">
				<div class="lbl-field width-100">
					@Html.Label("ddlSelectTop", Lang.SelectTop)
				</div>
				<div class="edit-field">
					@Html.DropDownList("ddlSelectTop", (IEnumerable<SelectListItem>)ViewBag.SelectTop, new { @class = "multiselect-width" })
				</div>
			</div>
			<div class="filter-cell">
				<div class="lbl-field width-100">
					@Html.Label("ddlCombo", Lang.Combo)
				</div>
				<div class="edit-field">
					@Html.DropDownList("ddlCombo", (IEnumerable<SelectListItem>)ViewBag.Combos, new { @class = "multiselect-width" })
				</div>
			</div>
			<div class="filter-cell">
				<div class="lbl-field width-80">
					@Html.Label("ddlSportTypes", Lang.SportTypes)
				</div>
				<div class="edit-field">
					@Html.DropDownList("ddlSportTypes", (IEnumerable<SelectListItem>)ViewBag.SportTypes, new { @class = "multiselect-width" })
				</div>
			</div>	
			<div class="filter-cell">
				<div class="lbl-field width-140">
					@Html.Label("txtMaxPayout", Lang.MaxPayoutAfterPT)
				</div>
				<div class="edit-field">
					@Html.TextBox("txtMaxPayout", string.Empty, new { @class = "multiselect-width" })
				</div>
			</div>
			
		</div>
		<div class="filter-row">
			<div class="filter-cell">
				<div class="lbl-field width-100">
					@Html.Label("ddlLevel", Lang.Level)
				</div>
				<div class="edit-field">
					@Html.DropDownList("ddlLevel", (IEnumerable<SelectListItem>)ViewBag.Levels, new { @class = "multiselect-width" })
				</div>
			</div>	
			<div class="filter-cell">
				<div class="lbl-field width-100">
					@Html.Label("ddlRefreshTime", Lang.RefreshTime)
				</div>
				<div class="edit-field width-auto">
					@Html.DropDownList("ddlRefreshTime", (IEnumerable<SelectListItem>)ViewBag.RefreshTimes, new { @class = "multiselect-width" })
					<span class=".relative">@Lang.Seconds</span>
				</div>
			</div>
			<div class="filter-cell cell-refresh">
				<input type="button" class="btn-refresh" id="divRefreshNow" disabled="true" />
				<label class="lbl-pause">
					@Html.CheckBox("chkPause", false)
					@Lang.Pause
				</label>
			</div>
			<div class="filter-cell">
				<div class="submit btn-mixParlay">
					<input type="button" class="btn-submit float-right" id="btnSearch" value="@Lang.Submit" />
				</div>
			</div>
		</div>
	</div>
</section>
<div id="divResult" class="display-none">
	<div style="max-height: 680px; width: 1227px">
		<table class="grid" id="tblHeader">
			<colgroup>
				<col width='100px' />
				<col width='150px' />
				<col width='120px' />
				<col width='150px' />
				<col width='120px' />
				<col width='150px' />
				<col width='180px' />
				<col width='120px' />
				<col width='100px' />
                <col width='17px' />
			</colgroup>
			<thead>
				<tr>
					<th>
						@Lang.No
					</th>
					<th class="sortable" data-col-type="date" id="colTransTime">
						@Lang.TransTime
					</th>
					<th>
						@Lang.BetId
					</th>
					<th class="sortable" data-col-type="ignorecase">
						@Lang.UserName
					</th>
					<th>
						@Lang.Odds
					</th>
					<th>
						@Lang.StakeAfterPT
					</th>
					<th class="sortable" data-col-type="float">
						@Lang.MaxPayoutAfterPT
					</th>
					<th>
						@Lang.TotalCombo
					</th>
					<th>
						@Lang.BetDetails
					</th>
                    <th></th>
				</tr>
			</thead>
		</table>
	</div>
	<div class="scrollGridContent" style="width: 1227px; overflow-y: scroll;">
		<table class="grid" id="tblResult" style="width: 1210px;">
			<colgroup>
				<col width='100px' />
				<col width='150px' />
				<col width='120px' />
				<col width='150px' />
				<col width='120px' />
				<col width='150px' />
				<col width='180px' />
				<col width='120px' />
				<col width='100px' />
			</colgroup>
			<tbody>
			</tbody>
		</table>
	</div>
</div>
@section Foot {
	<script type="text/javascript">
		var labels = {
			NoData: '@Lang.NoData',
			View: '@Lang.View',
            RefreshNow: '@Lang.RefreshNow'
		};
	</script>
	@Scripts.Render("~/Scripts/Tools/MixParlayMonitor")
}
