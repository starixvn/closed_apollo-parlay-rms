@using System.Web.Script.Serialization
@using Apollo.ParlayRMS.Core.Constants
@{
    ViewBag.Title = Lang.TopWinners;
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool hasEditRight = (bool)ViewBag.HasEditRight;
}
@section Head {
    @Styles.Render("~/Themes/MemberManagement")
}
@section Headline {
    <h1><span class="title">@ViewBag.Title</span></h1>
}
<section id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">			
                <div class="lbl-field width-100">
                    @Html.Label("ddlSelectTop", Lang.SelectTop)
                </div>
                <div class="edit-field">
                    @Html.DropDownList("ddlSelectTop", (IEnumerable<SelectListItem>)ViewBag.SelectTops, new { @class = "multiselect-width" })
                </div>
            </div>
            <div class="filter-cell">
                <div class="lbl-field width-100">
                    @Html.Label("ddlSportTypes", Lang.SportsType)
                </div>
                <div class="edit-field">
                    @Html.DropDownList("ddlSportTypes", (IEnumerable<SelectListItem>)ViewBag.SportTypes, new { @class = "multiselect-width" })
                </div>
            </div>
            <div class="filter-cell">
                <div class="lbl-field width-100">
                    @Html.Label("ddlCombo", Lang.Combo)
                </div>
                <div class="edit-field">
                    @Html.DropDownList("ddlCombo", (IEnumerable<SelectListItem>)ViewBag.Combos, new { @class = "multiselect-width" })
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field width-100">
                    @Html.Label("ddlDateRanges", Lang.DateRange)
                </div>
                <div class="edit-field">
                    @Html.DropDownList("ddlDateRanges", (List<SelectListItem>)ViewBag.DateRanges, new { @class = "multiselect-width" })
                </div>
            </div>
            <div class="filter-cell relative">
                <div class="lbl-field width-100">
                    @Html.Label("dpkDateFrom", Lang.From)
                </div>
                <div class="edit-field">
                    @Html.TextBox("dpkDateFrom", string.Empty, new { @class = "multiselect-width" })
                </div>
            </div>
            <div class="filter-cell relative">
                <div class="lbl-field width-100">
                    @Html.Label("dpkDateTo", Lang.To)
                </div>
                <div class="edit-field">
                    @Html.TextBox("dpkDateTo", string.Empty, new { @class = "multiselect-width" })
                </div>
            </div>
            <div class="filter-cell">
                <div class="submit">
                    <input type="button" class="btn-submit float-right" id="btnSubmit" value="@Lang.Submit" />
                </div>
            </div>
        </div>
    </div>
</section>
<div>
    <div id="divResult" class="freegrid display-none"></div>
</div>
<div id="divTopWinnerDetailsContainer" class="display-none">
    <div style="max-height: 600px;">
        <div id="divTopWinnerDetails" class="freegrid"></div>
    </div>
</div>
@Html.Hidden("imagePath", Url.Content("~/Content/themes/layout/img/calendar.gif"))
@section Foot {
    <script type="text/javascript">
        var labels = {
            No: '@Lang.No',
            Username: '@Lang.Username',
            Currency: '@Lang.Currency',
            OriginalCurrency: '@Lang.OriginalCurrency',
            BaseCurrency: '@Lang.BaseCurrency',
            Stake: '@Lang.Stake',
            WinningAmount: '@Lang.WinningAmount',
            CustomerWinLoss: '@Lang.CustomerWinLoss',
            CompanyLoseAmount: '@Lang.CompanyLoseAmount',
            CompanyWinLoss: '@Lang.CompanyWinLoss',
            TotalBets: '@Lang.TotalBets',
            AverageWinOdds: '@Lang.AverageWinnOdds',
            BetId: '@Lang.BetId',
            TotalCombo: '@Lang.TotalCombo',
            Odds: '@Lang.WinOdds',
            Total: '@Lang.Total',
            From: '@Lang.From',
            To: '@Lang.To',
            Total: '@Lang.Total',
            BetListOf: '@Lang.BetListOf'
        };
         var messages = {
            ChangeLevelConfirmation: '@Messages.ChangeLevelConfirmationMessage',
            ChangeLevelSuccessfully: '@Messages.ChangeLevelSuccessfullyMessage'
        };
        var dateRanges = {
            Yesterday : @Convert.ToInt32(CommonEnums.DateRange.Yesterday),
            CurrentWeek : @Convert.ToInt32(CommonEnums.DateRange.CurrentWeek),
            CurrentMonth : @Convert.ToInt32(CommonEnums.DateRange.CurrentMonth),
            LastWeek : @Convert.ToInt32(CommonEnums.DateRange.LastWeek),
            LastMonth : @Convert.ToInt32(CommonEnums.DateRange.LastMonth),
            SinceLastMonth : @Convert.ToInt32(CommonEnums.DateRange.SinceLastMonth),
            SpecificDate:  @Convert.ToInt32(CommonEnums.DateRange.SpecificDate)
        };
        var levels = @Html.Raw((new JavaScriptSerializer()).Serialize(ViewBag.Levels))
        var hasEditRight = '@hasEditRight' == 'True';
        var maxDate = '@DateTime.Now';
        var minDate = '@ViewBag.MinDate';
    </script>
    @Scripts.Render("~/Scripts/Reports/TopWinners")
}