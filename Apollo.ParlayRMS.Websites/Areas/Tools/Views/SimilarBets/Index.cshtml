@{
    ViewBag.Title = Lang.SimilarBets;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/Themes/BetList")
    @Styles.Render("~/Themes/MemberManagement")
}
@section Headline {
    <h1><span class="title">@ViewBag.Title</span></h1>
}
<section id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">	
            <div class="filter-cell">
                <div class="lbl-field width-auto">
                    @Html.Label("txtBetId", Lang.BetId)
                </div>
                <div class="edit-field">
                    @Html.TextBox("txtBetId", (long?)ViewBag.BetId, new { @class = "multiselect-width" })
                </div>
            </div>
            <div class="filter-cell">
                <div class="submit">
                    <input type="button" class="btn-submit float-right" id="btnSearch" value="@Lang.Submit" />
                </div>
            </div>
        </div>
    </div>
</section>
<div>
    <div id="divResult" class="freegrid display-none">
    </div>
</div>
<div class="detail-grid display-none">
    <div id="divDetails" class="freegrid display-none">
    </div>
</div>
@section Foot {
    <script type="text/javascript">
        var labels = {
            No: '@Lang.No',
            TransTime: '@Lang.TransTime',
            BetId: '@Lang.BetId',
            Odds: '@Lang.Odds',
            StakeAfterPT: '@Lang.StakeAfterPT',
            MaxPayoutAfterPT: '@Lang.MaxPayoutAfterPT',
            TotalCombo: '@Lang.TotalCombo',
            BetDetails: '@Lang.BetDetails',
            Username: '@Lang.Username',
            View: '@Lang.View',
            SimilarBets: '@Lang.SimilarBets',
            SimilarComboFound: '@Lang.SimilarComboFound',
            SimilarBetList: '@Lang.SimilarBetList'
        };
    </script>
    @Scripts.Render("~/Scripts/Tools/SimilarBets")
}