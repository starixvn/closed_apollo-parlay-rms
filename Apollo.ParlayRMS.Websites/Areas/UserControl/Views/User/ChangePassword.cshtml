@using Apollo.ParlayRMS.Core.Web
@using Apollo.ParlayRMS.Core.Resources
@using Fanex.NAP.Core.Web
@{
    ViewBag.Title = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool success = ViewBag.Success != null && ViewBag.Success;
    string message = ViewBag.Message != null ? ViewBag.Message : string.Empty;
}
@section Headline {
    <div class="usertitle">
        <div>
            <span>@Model.Username / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
@using (Html.BeginForm())
{
    <div id="filter-bar">
        <div class="filter-form">
            <div class="filter-row">
                <div class="filter-cell">
                    <div class="lbl-field col_5">
                        @ViewResources.Old_Password
                    </div>
                    <div class="edit-field col_10">
                        <input type="password" id="OldUserPwd" name="OldUserPwd" />
                    </div>
                </div>
            </div>
            <div class="filter-row">
                <div class="filter-cell">
                    <div class="lbl-field col_5">
                        @ViewResources.New_Password
                    </div>
                    <div class="edit-field col_10">
                        <input type="password" id="UserPwd" name="UserPwd" />
                    </div>
                </div>
            </div>
            <div class="filter-row">
                <div class="filter-cell">
                    <div class="lbl-field col_5">
                        @ViewResources.Confirm_Password
                    </div>
                    <div class="edit-field col_10">
                        <input type="password" id="ConfirmUserPwd" name="ConfirmUserPwd" />
                    </div>
                </div>
            </div>
            <div class="filter-row">
                <div class="lbl-field col_5">
                </div>
                <div class="filter-cell">
                    <div class="submit width-auto col_3">
                        <input id="btnSave" name="btnGenerate" type="submit" value="Save" class="" />
                    </div>
                    <div class="cancel width-auto col_3">
                        <input id="btnCancel" name="btnGenerate" type="button" value="Cancel" class="" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@section Foot {
    <script type="text/javascript">
     var success = @success.ToString().ToLower();
     var message = '@message';
     $(function () { 
        if(success == true)
        {
            ParlayRMS.showInfoMessage('@Messages.ChangedPassword');
        }
        else if(message != '')
        {
            ParlayRMS.showErrorMessage(message);
        }

        $("#btnSave").on("click",function(){
            ParlayRMS.closeMessage();
            var oldPass = $("#OldUserPwd").val();
            var newPass = $("#UserPwd").val();
            var confirmPass = $("#ConfirmUserPwd").val();
            if(oldPass == "")
            {
                ParlayRMS.showErrorMessage('@Messages.OldPasswordCannotEmpty', 'OldUserPwd');
                return false;
            } 
            else if(newPass == "")
            {
                ParlayRMS.showErrorMessage('@Messages.NewPasswordCannotEmpty', 'UserPwd');
                return false;
            }
            else if(confirmPass == "" )
            {
                ParlayRMS.showErrorMessage('@Messages.ConfirmPasswordCannotEmpty', 'ConfirmUserPwd');
                return false;
            } 
            else if(newPass != confirmPass)
            {
                ParlayRMS.showErrorMessage('@Messages.PasswordDoesNotMatch', 'ConfirmUserPwd');
                return false;
            } 
            else if(newPass.length < 5)
            {
                ParlayRMS.showErrorMessage('@Messages.PasswordMinLengthError', 'UserPwd');
                return false;
            }
        });

        $("#btnCancel").on("click",function(){
            window.location.href = '@Url.Action("Index", "Home", new { Area = "" })';
            return false;
        });
     })
    </script>
}
